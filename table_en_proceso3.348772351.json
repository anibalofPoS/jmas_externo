	"sql": "SELECT\r\n\tdate_format(fecha,'%Y-%m-%d') as fecha,\r\n\tdate_format(fecha_limpio,'%Y-%m-%d') as fecha_limpio,\r\n\tcount(*) as cajas\r\nFROM\r\n\ten_proceso\r\nWHERE\r\n    status='Limpio'\r\nGROUP BY\r\n    date_format(fecha,'%Y-%m-%d'),date_format(fecha_limpio,'%Y-%m-%d')\r\nORDER BY\r\n    fecha",
