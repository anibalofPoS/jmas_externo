{
	"sql": "SELECT\r\n\tfecha,\r\n\tcuenta,\r\n\tid_medidor,\r\n\tanomalia,\r\n\tanomalia_info,\r\n    datediff((select fecha from jmas_externo.banco where banco.cuenta=padron.cuenta limit 1),fecha) as dias,\r\n    (select status from jmas_externo.banco where cuenta=padron.cuenta limit 1) as status,\r\n    (select sector from pulsodelagua.padron where pulsodelagua.padron.cuenta=jmas_externo.padron.cuenta limit 1) as sector,\r\n    (select distrito from pulsodelagua.padron where pulsodelagua.padron.cuenta=jmas_externo.padron.cuenta limit 1) as distrito,\r\n    (select localizacion from pulsodelagua.padron where pulsodelagua.padron.cuenta=jmas_externo.padron.cuenta limit 1) as localizacion\r\nFROM\r\n\tpadron\r\nWHERE\r\n    (select status from jmas_externo.banco where cuenta=padron.cuenta limit 1) is null or\r\n    (select status from jmas_externo.banco where cuenta=padron.cuenta limit 1)<>'DCR' ",
